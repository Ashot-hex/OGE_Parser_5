{
    "compilerOptions": {
      "strict": true,
      "noImplicitAny": true,
      "alwaysStrict": true,
      "strictBindCallApply": true,
      "strictNullChecks": true,
      "strictFunctionTypes": true,
      "strictPropertyInitialization": true,
      "module": "commonjs",
      "target": "es6",
      "esModuleInterop": true,
      "sourceMap": true,
      "rootDir": "src",
      "outDir": "./dist/js",
      "noEmitOnError": true,
      "typeRoots": ["node_modules/@types"],
    },
    "include": [
        "./src/**/*.ts"
    ],
    "exclude": [
        "./Tests/**/*.ts",
        "node_modules"
    ],
  }
  