{
    "compilerOptions": {
        "typeRoots": [ "./node_modules/@types", "./Tests/Mocks**" ],
        "target": "es6",
        "module": "commonjs",
        "strict": true,
        "esModuleInterop": true,
        "outDir": "./Tests/dist/js",
        "rootDir": "./",
        "types": [ "jest", "node" ],
        "paths": {
            "@model/*": ["./src/Model/*"]
        }
    },
    "include": [ "./Tests/**/*.ts", "./Tests/**/*.d.ts" ],
    "exclude": [ "node_modules" ]
}